# Copy to /etc/uprint/uprint.env and replace the example values.
# Keep this file private; do not commit real secrets.

DATABASE_URL=sqlite:////home/REPLACE_WITH_PI_USERNAME/uPrint/backend/erb.db
UPLOAD_DIR=/home/REPLACE_WITH_PI_USERNAME/uPrint/backend/uploads
MAX_UPLOAD_BYTES=52428800

# Generate a long random token and use the same value in the Pi worker config.
DEVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Add the exact Cloudflare Pages origin after deploying the frontend.
# Example: CORS_ORIGINS=https://your-uprint.pages.dev
CORS_ORIGINS=
