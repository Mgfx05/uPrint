[Unit]
Description=uPrint FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_PI_USERNAME
Group=REPLACE_WITH_PI_USERNAME
WorkingDirectory=/home/REPLACE_WITH_PI_USERNAME/uPrint/backend
EnvironmentFile=/etc/uprint/uprint.env
ExecStart=/home/REPLACE_WITH_PI_USERNAME/uPrint/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

# Keep the API bound to localhost. Cloudflare Tunnel connects locally;
# do not expose FastAPI or CUPS directly to the public internet.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/REPLACE_WITH_PI_USERNAME/uPrint/backend

[Install]
WantedBy=multi-user.target
