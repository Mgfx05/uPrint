# uPrint backend configuration
DATABASE_URL=sqlite:///./erb.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800
DEVICE_TOKEN=replace-with-a-long-random-secret

# Raspberry Pi worker configuration
UPRINT_SERVER_URL=http://127.0.0.1:8000
UPRINT_DEVICE_TOKEN=replace-with-the-same-device-secret
UPRINT_PRINTER_NAME=Epson_L3210
UPRINT_SIMULATION_MODE=false
UPRINT_POLL_INTERVAL_SECONDS=5

# Cloudflare Tunnel will provide secure external HTTPS access to the Pi.
